# Milvus
MILVUS_URI=
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=

# Models
EMBED_MODEL=/root/autodl-tmp/Qwen/Qwen/Qwen3-VL-Embedding-2B
RERANK_MODEL=/root/autodl-tmp/Qwen/Qwen/Qwen3-VL-Reranker-2B
VLM_BASE_MODEL=/root/autodl-tmp/Qwen/Qwen3-VL-8B-Instruct
VLM_LORA_ADAPTER=/root/autodl-tmp/EvidenceMed-Agent/models/adapters/qwen3-vl-8b-medical-lora
# vLLM 服务直接加载合并后的 LoRA 模型；与原双卡部署日志保持一致。
VLM_MERGED_MODEL=/root/autodl-tmp/Qwen/Qwen3-VL-8B-Instruct-merged-lora-20260308

# API backend (optional)
MODELSCOPE_API_TOKEN=
EMBED_API_BASE_URL=
EMBED_API_PATH=/v1/embeddings
RERANK_API_BASE_URL=
RERANK_API_PATH=/v1/rerank

# Local vLLM service (recommended for deployment)
VLLM_API_KEY=
VLLM_EMBED_BASE_URL=http://127.0.0.1:8001
VLLM_RERANK_BASE_URL=http://127.0.0.1:8002
VLLM_VLM_BASE_URL=http://127.0.0.1:8003
