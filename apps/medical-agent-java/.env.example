MYSQL_DATABASE=medical_agent
MYSQL_USER=medical_agent
MYSQL_PASSWORD=change-this-mysql-password
MYSQL_ROOT_PASSWORD=change-this-root-password
REDIS_PASSWORD=change-this-redis-password
MINIO_ROOT_USER=change-this-minio-user
MINIO_ROOT_PASSWORD=change-this-minio-password
MILVUS_TOKEN=
DEMO_USERS_ENABLED=true
DEMO_USER_PASSWORD=change-this-user-password
DEMO_ADMIN_PASSWORD=change-this-admin-password

# vLLM services run outside this Compose stack, usually on the GPU host.
EMBEDDING_BASE_URL=http://host.docker.internal:8001
RERANKER_BASE_URL=http://host.docker.internal:8002
VLM_BASE_URL=http://host.docker.internal:8003
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
RERANKER_MODEL=Qwen/Qwen3-VL-Reranker-2B
VLM_MODEL=qwen3-vl-medical
EMBEDDING_DIMENSION=2048
VLLM_API_KEY=change-this-vllm-api-key
